{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "pretty": false,
    "noEmitOnError": true,
    "diagnostics": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "dist-obf"]
}
