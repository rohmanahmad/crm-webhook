  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "start": "ts-node src/server.ts",
    "build": "tsc",
    "prod": "npm run build && cp package.json dist",
    "test": "echo \"Error: no test specified\" && exit 1",
    "obfuscate": "javascript-obfuscator dist --output dist-obf --compact true --control-flow-flattening true --self-defending true --debug-protection true --disable-console-output true",
    "build:obf": "npm run build && npm run obfuscate && cp package.json dist-obf",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "command": "ts-node --transpile-only src/command.ts",
    "eslint": "eslint src --ext .ts,.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
