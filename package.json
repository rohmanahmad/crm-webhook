    "axios": "^1.13.5",
    "body-parser": "^1.20.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^2.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
